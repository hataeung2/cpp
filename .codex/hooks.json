{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$(git rev-parse --show-toplevel)/.codex/hooks/guard.py\"",
            "timeout": 15,
            "statusMessage": "Checking project rules"
          }
        ]
      }
    ]
  }
}
