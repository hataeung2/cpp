{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",

        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",

        "ATUGCC_ENABLE_PQXX": "OFF",
        "ATUGCC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "description": "Run inside the MSVC developer environment (VsDevCmd), which also puts Ninja on PATH. vcpkg: set ATUGCC_VCPKG_ROOT (see CMakeLists.txt).",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "description": "vcpkg is optional: ATUGCC_VCPKG_ROOT or VCPKG_ROOT, otherwise system packages (see CMakeLists.txt).",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-x64-relwithdebinfo",
      "displayName": "Windows x64 RelWithDebInfo",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-x64-relwithdebinfo",
      "displayName": "Linux x64 RelWithDebInfo",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-x64-asan",
      "displayName": "Linux x64 Debug + ASan/UBSan",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ATUGCC_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "linux-x64-tsan",
      "displayName": "Linux x64 Debug + TSan",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ATUGCC_SANITIZERS": "thread"
      }
    },
    {
      "name": "Configure preset using toolchain file",
      "displayName": "Configure preset using toolchain file",
      "inherits": "base",
      "description": "Sets Ninja generator, build and install directory",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-debug",          "configurePreset": "windows-x64-debug",          "displayName": "Windows x64 Debug" },
    { "name": "windows-x64-release",        "configurePreset": "windows-x64-release",        "displayName": "Windows x64 Release" },
    { "name": "windows-x64-relwithdebinfo", "configurePreset": "windows-x64-relwithdebinfo", "displayName": "Windows x64 RelWithDebInfo" },
    { "name": "linux-x64-debug",            "configurePreset": "linux-x64-debug",            "displayName": "Linux x64 Debug" },
    { "name": "linux-x64-release",          "configurePreset": "linux-x64-release",          "displayName": "Linux x64 Release" },
    { "name": "linux-x64-relwithdebinfo",   "configurePreset": "linux-x64-relwithdebinfo",   "displayName": "Linux x64 RelWithDebInfo" },
    { "name": "linux-x64-asan",             "configurePreset": "linux-x64-asan",             "displayName": "Linux x64 Debug + ASan/UBSan" },
    { "name": "linux-x64-tsan",             "configurePreset": "linux-x64-tsan",             "displayName": "Linux x64 Debug + TSan" }
  ],
  "testPresets": [
    { "name": "test-base", "hidden": true, "output": { "outputOnFailure": true } },
    { "name": "windows-x64-debug",          "inherits": "test-base", "configurePreset": "windows-x64-debug" },
    { "name": "windows-x64-release",        "inherits": "test-base", "configurePreset": "windows-x64-release" },
    { "name": "windows-x64-relwithdebinfo", "inherits": "test-base", "configurePreset": "windows-x64-relwithdebinfo" },
    { "name": "linux-x64-debug",            "inherits": "test-base", "configurePreset": "linux-x64-debug" },
    { "name": "linux-x64-release",          "inherits": "test-base", "configurePreset": "linux-x64-release" },
    { "name": "linux-x64-relwithdebinfo",   "inherits": "test-base", "configurePreset": "linux-x64-relwithdebinfo" },
    { "name": "linux-x64-asan",             "inherits": "test-base", "configurePreset": "linux-x64-asan" },
    { "name": "linux-x64-tsan",             "inherits": "test-base", "configurePreset": "linux-x64-tsan" }
  ]
}
