{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: gcc build active file",
      "command": "/usr/bin/gcc",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Task generated by Debugger."
    },
    {
      "label": "Playground: start",
      "detail": "Local web playground (spec 070-02): build the frontend if needed, start the server, open the browser",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/playground.py", "--open"],
      "windows": {
        "command": "py",
        "args": ["-3", "${workspaceFolder}/tools/playground.py", "--open"]
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "atugcc-playground",
        "pattern": { "regexp": "^error: (.*)$", "message": 1 },
        "background": { "activesBegin": true, "beginsPattern": "^\\+ ", "endsPattern": "^atugcc playground: " }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Playground: start (dev)",
      "detail": "Same with the Vite dev server (hot reload) on 127.0.0.1:5173",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/playground.py", "--dev", "--open"],
      "windows": {
        "command": "py",
        "args": ["-3", "${workspaceFolder}/tools/playground.py", "--dev", "--open"]
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "atugcc-playground",
        "pattern": { "regexp": "^error: (.*)$", "message": 1 },
        "background": { "activesBegin": true, "beginsPattern": "^\\+ ", "endsPattern": "^atugcc playground: " }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ],
  "version": "2.0.0"
}